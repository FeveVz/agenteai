# ── OpenAI (obligatorio) ──────────────────────────────────────────
OPENAI_API_KEY=tu_openai_api_key_aqui

# ── Supabase (obligatorio) ────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# ── Twilio WhatsApp ───────────────────────────────────────────────
# Necesario solo para las respuestas asíncronas: cuando OpenAI tarda
# más de 9s, se libera el webhook y la respuesta sale por la REST API.
# Sin estas variables las respuestas lentas nunca llegan al cliente.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Servidor ──────────────────────────────────────────────────────
PORT=3001
