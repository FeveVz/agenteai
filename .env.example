# ══════════════════════════════════════════════════════════════════
#  Un solo repositorio, un despliegue por clienta.
#
#  TODAS estas variables son propias de cada despliegue. Copiar el
#  archivo de una clienta a otra sin cambiarlas hace que dos agentes
#  compartan base de datos, número de WhatsApp y panel.
# ══════════════════════════════════════════════════════════════════

# ── OpenAI (obligatorio) ──────────────────────────────────────────
OPENAI_API_KEY=tu_openai_api_key_aqui

# ── Supabase (obligatorio) ────────────────────────────────────────
# Una base POR CLIENTA. Es lo que mantiene separados sus proyectos,
# visitas y conversaciones.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# ── URL pública de este despliegue (obligatorio) ──────────────────
# Con esto el agente arma el enlace del calendario que le manda al
# cliente por WhatsApp: APP_URL + /visita/<codigo>.
#
# Sin definirla, el agente NO manda el enlace y pide los datos por
# chat. Es a propósito: antes caía a un dominio fijo, así que un
# despliegue nuevo le mandaba a sus clientes el enlace de otra
# empresa, que además no resolvía porque el código del enlace vive
# en otra base de datos.
#
# Sin barra al final. Ej: https://pamela-barrios.vercel.app
APP_URL=

# ── Marca de este despliegue (se hornea en el build) ──────────────
# El <title>, el meta description y el favicon tienen que existir ANTES
# de que cargue JavaScript: es lo que lee el bot de WhatsApp cuando
# alguien reenvia el enlace de agenda. Por eso salen de aca y no de la
# base de datos como el resto de la configuracion.
#
# Si faltan, la pagina queda generica — nunca con la marca de otra clienta.
VITE_MARCA_NOMBRE=
VITE_MARCA_DESCRIPTOR=
VITE_MARCA_AGENTE=

# ── Twilio WhatsApp ───────────────────────────────────────────────
# TWILIO_AUTH_TOKEN cumple dos funciones:
#   1. Valida la firma del webhook (solo Twilio puede invocarlo).
#      Sin esta variable el webhook acepta peticiones de cualquier origen.
#   2. Envía las respuestas asíncronas: cuando OpenAI tarda más de 9s se
#      libera el webhook y la respuesta sale por la REST API. Sin las tres
#      variables, esas respuestas lentas nunca llegan al cliente.
#
# OJO: TWILIO_WHATSAPP_FROM tiene que ser un número PROPIO de cada
# clienta. El sandbox compartido (+14155238886) apunta a una sola URL
# de webhook por cuenta de Twilio: si dos despliegues lo reusan, el
# segundo se roba el webhook y el primero se queda mudo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+51999999999

# ── Panel de control (obligatorio) ────────────────────────────────
# Contraseña para entrar a /dashboard y usar la API de gestión.
#
# Sin esto la API de gestión queda CERRADA (503) y el panel no abre.
# Falla cerrado a propósito: acá se ven las conversaciones y los
# teléfonos de los clientes, y un panel que no abre se nota en cinco
# minutos, mientras que uno público no se nota nunca.
PANEL_PASSWORD=

# ── Alertas por correo (opcional) ─────────────────────────────────
# Avisa al equipo cuando se agenda una visita. Los destinatarios se
# configuran desde el panel, no acá.
# Saca la key en https://resend.com (gratis hasta 3.000 correos/mes).
# Sin esta variable no se envía nada, pero agendar sigue funcionando.
RESEND_API_KEY=
# Remitente. Si se deja vacío usa el dominio de pruebas de Resend con
# el nombre de la empresa que esté cargado en el panel, que no requiere
# verificar nada. Para usar un dominio propio hay que verificarlo en
# Resend: RESEND_FROM=Pamela Barrios <visitas@tudominio.pe>
RESEND_FROM=

# ── Servidor ──────────────────────────────────────────────────────
PORT=3001
