# ── OpenAI (obligatorio) ──────────────────────────────────────────
OPENAI_API_KEY=tu_openai_api_key_aqui

# ── Supabase (obligatorio) ────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key_aqui

# ── Twilio WhatsApp ───────────────────────────────────────────────
# TWILIO_AUTH_TOKEN cumple dos funciones:
#   1. Valida la firma del webhook (solo Twilio puede invocarlo).
#      Sin esta variable el webhook acepta peticiones de cualquier origen.
#   2. Envía las respuestas asíncronas: cuando OpenAI tarda más de 9s se
#      libera el webhook y la respuesta sale por la REST API. Sin las tres
#      variables, esas respuestas lentas nunca llegan al cliente.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Panel de control ──────────────────────────────────────────────
# Contraseña para entrar a /dashboard y usar la API de gestión.
# La app NO tiene otra autenticación: sin esto, cualquiera que llegue
# a la URL ve las conversaciones y los datos de tus clientes.
PANEL_PASSWORD=

# ── Alertas por correo (opcional) ─────────────────────────────────
# Avisa al equipo cuando se agenda una visita. Los destinatarios se
# configuran desde el panel, no aquí.
# Sacá la key en https://resend.com (gratis hasta 3.000 correos/mes).
# Sin esta variable no se envía nada, pero agendar sigue funcionando.
RESEND_API_KEY=
# Remitente. Por defecto usa el dominio de pruebas de Resend, que no
# requiere verificar nada. Para usar uno propio hay que verificar el
# dominio en Resend: RESEND_FROM=Ceinys <visitas@ceinys.pe>
RESEND_FROM=

# ── Servidor ──────────────────────────────────────────────────────
PORT=3001
